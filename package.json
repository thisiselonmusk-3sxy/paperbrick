{
  "name": "paperbrick-architects",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:assets": "node --import tsx scripts/validate-assets.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate:assets"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "sharp": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
